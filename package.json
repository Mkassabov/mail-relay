{
  "name": "mail-relay",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --test src/*.test.ts",
    "admin": "node --env-file=.env src/admin.ts",
    "build:cli": "node --env-file=.env scripts/build-cli.mjs",
    "plan": "alchemy plan --stage prod",
    "deploy": "alchemy deploy --stage prod",
    "destroy": "alchemy destroy --stage prod",
    "tail": "alchemy tail --stage prod",
    "dev": "alchemy dev --stage prod"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.111",
    "alchemy": "https://pkg.ing/alchemy/dc87a4d",
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@types/node": "^24.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260521.1",
    "esbuild": "^0.25.9",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0"
}
