# Full hostname that receives mail. The zone (last two labels) must already
# exist on Cloudflare and use Cloudflare nameservers.
MAIL_RELAY_DOMAIN=relay.example.com

# Destination template. ${alias} is replaced with the local part of the inbound
# address. Only the BASE address needs verifying on the Cloudflare account:
# Cloudflare matches you+anything@example.com against a verified you@example.com.
MAIL_RELAY_FORWARD_TEMPLATE=you+${alias}@example.com

# Bearer token for the admin HTTP API / CLI. Generate with: openssl rand -hex 32
ADMIN_BEARER_TOKEN=

# Used by the admin CLI after deploy (copy from the deploy output `url`).
WORKER_URL=

# NOTE: the deploy stage is pinned in package.json (`--stage ...`), not here.
# STAGE and --profile are both resolved before .env is loaded, so setting them
# in this file has no effect. Use ALCHEMY_PROFILE=<name> in your environment if
# your saved profile is not the default.
