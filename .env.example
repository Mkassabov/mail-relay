# Full hostname that receives mail (zone must already exist on Cloudflare).
MAIL_RELAY_DOMAIN=relay.example.com

# Destination template. ${alias} is replaced with the local part of the inbound address.
MAIL_RELAY_FORWARD_TEMPLATE=user+${alias}@example.com

# Bearer token for the admin HTTP API / CLI.
ADMIN_BEARER_TOKEN=

# Used by the admin CLI after deploy (copy from stack output `url`).
WORKER_URL=
